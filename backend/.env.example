DATABASE_URL=sqlite:///./feature_flags.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
WORKSPACE_DIR=./workspaces
FLAGS_HARK_BIN=flagshark
PIRANHA_BIN=piranha
GIT_BIN=git
MVN_BIN=mvn
SCAN_TIMEOUT_SEC=300
PIRANHA_TIMEOUT_SEC=300
TEST_TIMEOUT_SEC=900
CLONE_TIMEOUT_SEC=300
# PostgreSQL (primary in Docker Compose). No hardcoded passwords: leave empty
# for SQLite dev mode, or export POSTGRES_PASSWORD locally / via .env (git-ignored).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ffsd
POSTGRES_USER=ffsd
POSTGRES_PASSWORD=
