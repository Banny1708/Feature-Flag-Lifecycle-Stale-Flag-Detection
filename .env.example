# Frontend (Vite) — copy to .env to point the UI at the backend
VITE_API_URL=http://127.0.0.1:8000

# PostgreSQL (Docker Compose service `postgres`).
# NEVER commit real passwords: keep secrets in a local .env, not in git.
POSTGRES_DB=ffsd
POSTGRES_USER=ffsd
POSTGRES_PASSWORD=change-me-locally

# Backend (local dev without Docker; Docker sets DATABASE_URL to postgres DSN)
# DATABASE_URL=sqlite:///./feature_flags.db
# FRONTEND_ORIGIN=http://localhost:5173
